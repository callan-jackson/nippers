# Netlify: set these as site environment variables (netlify env:set KEY value).
# Docker: copy to .env. Azure: infra/deploy.sh sets the equivalents.
STORE=postgres                  # postgres | cosmos | file
DATABASE_URL=                   # Neon pooled connection string (STORE=postgres)
COSMOS_CONNECTION_STRING=       # STORE=cosmos only
COSMOS_DATABASE=nippers
JWT_SECRET=change-me-to-32-plus-random-characters
ADMIN_EMAIL=nippers1973@outlook.com
ADMIN_PASSWORD=change-me-before-first-run
APP_URL=https://nippers.org.uk  # used in emails and the CSRF origin check
RESEND_API_KEY=                 # optional — emails are logged until set
MAIL_FROM=N.I.P.P.E.R.S. <bookings@nippers.org.uk>
