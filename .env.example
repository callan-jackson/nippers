# Copy to .env for docker-compose, or set the same keys as Static Web App
# application settings in Azure (infra/deploy.sh does this for you).
STORE=file                      # file | cosmos
COSMOS_CONNECTION_STRING=       # required when STORE=cosmos
COSMOS_DATABASE=nippers
JWT_SECRET=change-me-to-32-plus-random-characters
ADMIN_EMAIL=nippers1973@outlook.com
ADMIN_PASSWORD=change-me-before-first-run
APP_URL=https://nippers.org.uk  # used in emails (reset links, booking links)
RESEND_API_KEY=                 # optional — emails are logged until set
MAIL_FROM=N.I.P.P.E.R.S. <bookings@nippers.org.uk>
